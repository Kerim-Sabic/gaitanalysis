# Horalix Gait AI — backend configuration (prefix HORALIX_)

# Pose backend: auto_best | mediapipe_tasks_full | mediapipe_tasks_heavy |
# mmpose_rtmw | mmpose_rtmw3d | ultralytics_pose | demo
HORALIX_POSE_BACKEND=auto_best

# Allow one-click demo runs (simulated keypoints, clearly labelled)
HORALIX_ALLOW_DEMO_MODE=true

# Storage (local-first; swap for PostgreSQL in production)
# HORALIX_DATABASE_URL=postgresql://user:pass@localhost:5432/horalix

# Live preview and final-analysis backends
HORALIX_LIVE_BACKEND=mediapipe_tasks_full
HORALIX_FINAL_BACKEND=auto_best
HORALIX_AUTO_BEST_MODE=fast

# Optional advanced helpers; enable only in their isolated/Docker runtimes.
HORALIX_ENABLE_SAM2=false
HORALIX_ENABLE_DEPTH=false
HORALIX_ENABLE_WHAM=false
HORALIX_ADVANCED_MODELS_REQUIRE_DOCKER=false

# Comma-separated web origins. Include the Netlify and custom domains in production.
HORALIX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
