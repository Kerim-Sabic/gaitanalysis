# Isolated Depth Anything V2 verification runtime.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      git ffmpeg libglib2.0-0 libgl1 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /repo
COPY apps/api/requirements.txt /tmp/requirements-api.txt
RUN python -m pip install --upgrade pip && \
    python -m pip install -r /tmp/requirements-api.txt && \
    python -m pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu && \
    git clone --depth 1 https://github.com/DepthAnything/Depth-Anything-V2.git /opt/depth-anything-v2

COPY apps/api/app ./apps/api/app
COPY scripts ./scripts

ENV PYTHONPATH=/repo/apps/api \
    HORALIX_ENABLE_DEPTH=true \
    HORALIX_DEPTH_SOURCE=/opt/depth-anything-v2 \
    HORALIX_DEPTH_MODEL_PATH=/repo/models/depth/Depth-Anything-V2-Small/depth_anything_v2_vits.pth

CMD ["python", "scripts/verify_depth_anything.py"]
