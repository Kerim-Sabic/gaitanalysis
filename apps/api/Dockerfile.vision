FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      git ffmpeg libglib2.0-0 libgl1 build-essential \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-real.txt requirements-sam2.txt requirements-depth.txt ./
RUN python -m pip install --upgrade pip && \
    python -m pip install -r requirements-real.txt && \
    python -m pip install -r requirements-sam2.txt && \
    python -m pip install -r requirements-depth.txt

COPY app ./app
COPY scripts ./scripts

ENV HORALIX_POSE_BACKEND=auto_best
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
